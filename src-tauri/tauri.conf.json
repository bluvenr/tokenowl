{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenOwl",
  "version": "1.0.0",
  "identifier": "com.virapi.tokenowl",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenOwl",
        "width": 900,
        "height": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      },
      {
        "label": "tray",
        "title": "TokenOwl",
        "width": 320,
        "height": 400,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.github.com https://github.com https://raw.githubusercontent.com https://cdn.jsdelivr.net https://*.gitee.com https://gitee.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
